<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="osz_app_launcher.NavBar" t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//Dropdown" position="replace">
            <button type="button" class="osz-launcher-toggle" data-hotkey="h"
                title="Aplicaciones" aria-label="Abrir aplicaciones" aria-haspopup="dialog"
                t-on-click="openOszLauncher">
                <i class="oi oi-apps" aria-hidden="true"/>
            </button>
        </xpath>
        <xpath expr="//a[@t-ref='menuApps']" position="before">
            <button t-if="!isScopedApp" type="button" class="osz-launcher-toggle"
                title="Aplicaciones" aria-label="Abrir aplicaciones" aria-haspopup="dialog"
                t-on-click="openOszLauncher">
                <i class="oi oi-apps" aria-hidden="true"/>
            </button>
        </xpath>
    </t>

    <t t-name="osz_app_launcher.Launcher">
        <Dialog fullscreen="true" size="'fullscreen'" header="false" footer="false"
            withBodyPadding="false" contentClass="'osz-launcher-dialog osz-theme-' + state.theme">
            <section class="osz-launcher" aria-label="Aplicaciones OSZ ERP" t-att-aria-busy="state.busy ? 'true' : 'false'">
                <header class="osz-launcher-header">
                    <div class="osz-launcher-brand"><span class="osz-brand-mark">OSZ</span><span>ERP</span></div>
                    <div class="osz-launcher-controls">
                        <button type="button" class="osz-icon-button" t-on-click="toggleTheme"
                            title="Cambiar tema" aria-label="Modo oscuro" t-att-aria-pressed="state.theme === 'dark' ? 'true' : 'false'">
                            <i t-att-class="state.theme === 'light' ? 'fa fa-moon-o' : 'fa fa-sun-o'" aria-hidden="true"/>
                        </button>
                        <button type="button" class="osz-icon-button" t-on-click="props.close" title="Cerrar" aria-label="Cerrar aplicaciones">
                            <i class="oi oi-close" aria-hidden="true"/>
                        </button>
                    </div>
                </header>
                <div class="osz-launcher-main">
                    <div class="osz-launcher-heading">
                        <h1>Aplicaciones</h1>
                        <p>Tu espacio de trabajo.</p>
                    </div>
                    <div class="osz-launcher-search">
                        <i class="fa fa-search" aria-hidden="true"/>
                        <label class="visually-hidden" for="osz-app-search">Buscar aplicaciones</label>
                        <input id="osz-app-search" type="search" placeholder="Buscar aplicaciones…" autocomplete="off"
                            t-model="state.query" t-ref="autofocus" t-on-keydown="onSearchKeydown"/>
                    </div>
                    <nav class="osz-app-grid" aria-label="Aplicaciones disponibles">
                        <a t-foreach="apps" t-as="app" t-key="app.id" class="osz-app-tile"
                            t-att-href="href(app)" t-att-data-menu-xmlid="app.xmlid"
                            t-att-aria-disabled="state.busy ? 'true' : undefined"
                            t-on-click="(event) => this.openApp(app, event)">
                            <span class="osz-app-icon">
                                <img t-if="app.webIconData" t-att-src="app.webIconData" alt="" width="52" height="52"/>
                                <i t-else="" class="oi oi-apps osz-app-fallback" aria-hidden="true"/>
                            </span>
                            <span class="osz-app-name" t-esc="app.name"/>
                        </a>
                    </nav>
                    <p t-if="!apps.length" class="osz-empty" role="status">No se encontraron aplicaciones.</p>
                    <p class="osz-launcher-hint" role="status">
                        <t t-if="state.busy">Abriendo aplicación…</t>
                        <t t-else="">Selecciona una aplicación para empezar.</t>
                    </p>
                </div>
            </section>
        </Dialog>
    </t>
</templates>
