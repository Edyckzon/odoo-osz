<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="muk_web_appsbar.AppsBar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('mk_apps_sidebar_logo')]" position="replace">
            <div class="mk_apps_sidebar_logo p-2">
                <img src="/osz_branding/static/img/osz-erp-inverse.svg"
                     alt="OSZ ERP" width="180" height="53" class="img-fluid mx-auto"/>
            </div>
        </xpath>
    </t>
</templates>
